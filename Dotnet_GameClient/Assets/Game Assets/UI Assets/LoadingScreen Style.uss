.loading-root {
    flex-grow: 1;
    background-color: var(--col-bg);
    align-items: center;
    justify-content: space-between;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
    -unity-font-definition: url("project://database/Assets/_FontAssets/Moneygraphy-Pixel.ttf?fileID=12800000&guid=4716975891402404ca00bfef10e11c59&type=3#Moneygraphy-Pixel");
}

.loading__center {
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}

.center__game-title {
    font-size: 110px;
    color: var(--col-accent);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(212, 212, 212);
    letter-spacing: 8px;
}

.center__game-subtitle {
    font-size: 26px;
    color: var(--col-text-dim);
    margin-top: 18px;
    margin-right: 18px;
    margin-bottom: 18px;
    margin-left: 18px;
    letter-spacing: 4px;
}

.loading__bottom {
    width: 100%;
    height: 100px;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
}

.bottom__status {
    font-size: 22px;
    color: var(--col-text);
    margin-bottom: 14px;
}

.progress-track {
    width: 100%;
    height: 191px;
    background-color: var(--col-track);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--col-border-light);
    border-right-color: var(--col-border-light);
    border-bottom-color: var(--col-border-light);
    border-left-color: var(--col-border-light);
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
}

.progress-fill {
    height: 100%;
    background-color: var(--col-success);
    width: 0;
}

.version-label {
    font-size: 18px;
    color: var(--col-text-dim);
    position: absolute;
    right: 10px;
    bottom: -40px;
}
