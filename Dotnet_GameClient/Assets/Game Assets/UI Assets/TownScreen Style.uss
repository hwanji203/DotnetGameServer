.town-screen {
    flex-grow: 1;
    background-color: var(--col-bg);
}

.leave-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    height: 48px;
    padding: 0 18px;
    font-size: 20px;
    background-color: var(--col-panel);
    border-width: 3px;
    border-color: var(--col-border-light);
    border-radius: 0;
    color: var(--col-text);
    margin: 0;
}

.leave-btn:hover {
    background-color: var(--col-panel-soft);
    border-color: var(--col-accent);
    color: var(--col-accent);
}