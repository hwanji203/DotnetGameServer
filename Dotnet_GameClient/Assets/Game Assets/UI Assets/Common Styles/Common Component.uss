/* 재사용 버튼 스타일. Desktop_Theme.tss가 @import → 어느 화면에서든 class="btn" 로 사용.
   픽셀 룩을 위해 모서리 라운드 없음(border-radius:0)·굵은 실선 테두리·눌림 효과. */
.btn {
    -unity-text-align: middle-center;
    color: var(--col-text);
    background-color: var(--col-panel-soft);
    border-width: 3px;
    border-color: var(--col-border-light);
    border-radius: 0;
    padding: 12px 28px;
    margin: 4px;
    font-size: 22px;
    transition-property: background-color, translate;
    transition-duration: 0.05s;
}

.btn:hover {
    background-color: var(--col-border);
    border-color: var(--col-accent);
}

.btn:active {
    background-color: var(--col-accent-dark);
    translate: 0 3px;
}

/* 주요 액션(강조) 버튼 */
.btn--primary {
    background-color: var(--col-accent);
    color: rgb(26, 16, 32);
    border-color: var(--col-accent-dark);
}

.btn--primary:hover {
    background-color: rgb(255, 202, 74);
    border-color: var(--col-accent);
}